{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "realpotentialvisuals",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "realpotentialvisuals.com", "custom_domain": true },
    { "pattern": "www.realpotentialvisuals.com", "custom_domain": true }
  ],

  // Publishable keys are designed to be public — safe to commit.
  // STRIPE_SECRET_KEY is NOT here; it's set via `wrangler secret put`.
  "vars": {
    "STRIPE_PUBLISHABLE_KEY": "pk_test_51UFPymRpZCDiXLbkpLGJokCGgHpFTOg84cdJHQ3RRCt7gXYcyOPiCwBseh6rU6tS2hyWD6dLW9xEmVuVDv2wElSz00J9ML8qhX"
  },

  // --- Storage bindings (Section 7 of the project briefing) ---
  // KV still commented out — connect once a real namespace exists
  // (`wrangler kv namespace create`), then run `npm run cf-typegen`.
  "d1_databases": [
    { "binding": "DB", "database_name": "realpotential", "database_id": "806c40bb-cebc-49e5-b61e-2d7d736ad19f" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "realpotential-media" }
  ],
  // "kv_namespaces": [
  //   { "binding": "SESSIONS", "id": "REPLACE_ME" }
  // ],

  "observability": {
    "enabled": true
  }
}
